rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own vendor document
    match /vendors/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read access to vendor profiles for booking pages
    match /vendors/{vendorId} {
      allow read: if true; // Allow public read for vendor booking pages
    }
    
    // Allow users to create bookings
    match /bookings/{bookingId} {
      allow create: if true; // Allow anyone to create bookings
      allow read: if true; // Allow public read for booking status pages
      allow update: if request.auth != null && 
        (resource.data.vendorId == request.auth.uid || 
         request.auth.token.email == resource.data.customerEmail);
    }
    
    // Allow users to create and manage their own services
    match /services/{serviceId} {
      allow read, write: if request.auth != null && 
        resource.data.vendorEmail == request.auth.token.email;
      allow create: if request.auth != null;
      // Allow public read access to services for vendor booking pages
      allow read: if true; // Allow public read for vendor booking pages
    }
  }
}
