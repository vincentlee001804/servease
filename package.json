{
  "name": "servease",
  "version": "1.0.0",
  "description": "ServEase - Digital Service Menu and Booking System",
  "main": "server.js",
  "scripts": {
    "setup": "node setup.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "render-postbuild": "cd client && npm install && npm run build",
    "firebase-deploy": "node deploy-firebase.js",
    "firebase-serve": "firebase serve",
    "firebase-emulators": "firebase emulators:start",
    "deploy-complete": "node deploy-complete.js"
  },
  "keywords": [
    "booking",
    "services",
    "qr-code",
    "local-business"
  ],
  "author": "ServEase Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "firebase-functions": "^6.6.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "shortid": "^2.2.17",
    "socket.io": "^4.8.1"
  }
}
