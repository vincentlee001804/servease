rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Vendor profile images - users can upload to their own folder
    match /vendor-profiles/{userId}/{allPaths=**} {
      // Allow read access to all authenticated users (so customers can see vendor images)
      allow read: if request.auth != null;
      
      // Allow write access only to the authenticated user's own folder
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
    }
    
    // AI posters - users can upload to their own folder
    match /ai-posters/{userId}/{allPaths=**} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;
      
      // Allow write access only to the authenticated user's own folder
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

